# OpenField env vars
#
# Required for Vercel Blob (file uploads in the studio). Get one free at
# https://vercel.com — sign up, create a project, then "Storage → Blob →
# Create → Copy token".
OPEN_HIGGSFIELD_READ_WRITE_TOKEN=

# Optional: public URL of your deployment (used for OG tags and sitemap).
# On Vercel this is auto-detected; set it only for custom domains.
NEXT_PUBLIC_SITE_URL=
