{
  "name": "openfield-ai",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start",
    "brand": "node scripts/build-brand-assets.mjs",
    "pages:build": "npx @cloudflare/next-on-pages",
    "pages:deploy": "npx @cloudflare/next-on-pages && wrangler pages deploy .vercel/output/static --project-name=openfield",
    "cf-build": "npx opennextjs-cloudflare build",
    "cf-deploy": "npx opennextjs-cloudflare build && wrangler deploy"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.13",
    "@tanstack/react-virtual": "^3.14.10",
    "@vercel/blob": "^2.8.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.16",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.2",
    "wrangler": "^4.154.0"
  }
}