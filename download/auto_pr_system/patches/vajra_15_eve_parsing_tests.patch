+"""Tests for eve.json alert parsing and severity mapping (#15).
+
+These tests cover:
+- ``SOAREngine._parse_eve_alert`` — parses a single eve.json alert line.
+- ``KafkaBridge._map_severity`` — maps Suricata severity 1-4 to internal
+  critical/high/medium/low, with medium as the safe default for missing
+  or unknown severities.
+"""
+import json
+from pathlib import Path
+
+import pytest
+
+from vajra.soar.engine import SOAREngine
+from vajra.pipeline.kafka_bridge import KafkaBridge
+
+
+FIXTURES = Path(__file__).parent.parent / "fixtures" / "eve" / "sample_alerts.json"
+
+
+@pytest.fixture
+def sample_alerts() -> list[dict]:
+    """Load the 5 sample alerts from fixture file."""
+    alerts = []
+    with FIXTURES.open() as f:
+        for line in f:
+            line = line.strip()
+            if line:
+                alerts.append(json.loads(line))
+    assert len(alerts) == 5, "Expected 5 fixture alerts"
+    return alerts
+
+
+# ===== SOAREngine._parse_eve_alert =====
+
+class TestParseEveAlert:
+    def _engine(self) -> SOAREngine:
+        # Build a minimal engine instance for parsing (no Kafka/Pulsar needed)
+        return SOAREngine.__new__(SOAREngine)
+
+    def test_parse_returns_dict_with_required_fields(self, sample_alerts):
+        eng = self._engine()
+        result = eng._parse_eve_alert(sample_alerts[0])
+        assert isinstance(result, dict)
+        assert "signature" in result
+        assert "src_ip" in result
+        assert "dest_ip" in result
+        assert "severity" in result
+
+    def test_parse_extracts_signature_id(self, sample_alerts):
+        eng = self._engine()
+        result = eng._parse_eve_alert(sample_alerts[0])
+        assert result["signature_id"] == 2100498
+
+    def test_parse_extracts_src_and_dest(self, sample_alerts):
+        eng = self._engine()
+        result = eng._parse_eve_alert(sample_alerts[0])
+        assert result["src_ip"] == "192.168.1.100"
+        assert result["dest_ip"] == "10.0.0.1"
+        assert result["dest_port"] == 80
+
+    def test_parse_preserves_severity(self, sample_alerts):
+        eng = self._engine()
+        result = eng._parse_eve_alert(sample_alerts[0])
+        assert result["severity"] == 1
+
+    def test_parse_handles_missing_severity(self, sample_alerts):
+        """Last fixture line has no 'severity' key — parser must not crash."""
+        eng = self._engine()
+        result = eng._parse_eve_alert(sample_alerts[4])
+        # Implementation detail: severity either defaults or is None
+        assert "severity" in result
+
+    def test_parse_invalid_input_raises(self):
+        eng = self._engine()
+        with pytest.raises((KeyError, ValueError, TypeError)):
+            eng._parse_eve_alert({})
+
+
+# ===== KafkaBridge._map_severity =====
+
+class TestMapSeverity:
+    def _bridge(self) -> KafkaBridge:
+        return KafkaBridge.__new__(KafkaBridge)
+
+    @pytest.mark.parametrize("suricata_severity,expected", [
+        (1, "critical"),
+        (2, "high"),
+        (3, "medium"),
+        (4, "low"),
+    ])
+    def test_known_severities(self, suricata_severity, expected):
+        bridge = self._bridge()
+        assert bridge._map_severity(suricata_severity) == expected
+
+    @pytest.mark.parametrize("missing_value", [None, 0, -1, 5, 99, "unknown"])
+    def test_unknown_or_missing_severity_defaults_to_medium(self, missing_value):
+        bridge = self._bridge()
+        assert bridge._map_severity(missing_value) == "medium"
+
+    def test_missing_severity_key_in_dict(self):
+        """Alert dict without 'severity' field should map to 'medium'."""
+        bridge = self._bridge()
+        alert = {"signature": "test", "src_ip": "1.2.3.4"}
+        # Method accepts either int or dict-with-severity-key — both should
+        # default to medium when severity is absent
+        result = bridge._map_severity(alert.get("severity"))
+        assert result == "medium"
+
+    @pytest.mark.parametrize("suricata_severity,expected", [
+        (1, "critical"),
+        (2, "high"),
+        (3, "medium"),
+        (4, "low"),
+        (None, "medium"),
+    ])
+    def test_full_alert_round_trip(self, sample_alerts, suricata_severity, expected):
+        """End-to-end: parse → map_severity → ensure mapped value matches table."""
+        eng = self._engine_for_parse()
+        bridge = self._bridge()
+        # Pick fixture by severity
+        alert = next(
+            (a for a in sample_alerts if a["alert"].get("severity") == suricata_severity),
+            None,
+        )
+        if alert is None:
+            pytest.skip(f"No fixture for severity {suricata_severity}")
+        parsed = eng._parse_eve_alert(alert)
+        mapped = bridge._map_severity(parsed.get("severity"))
+        assert mapped == expected
+
+    def _engine_for_parse(self) -> SOAREngine:
+        return SOAREngine.__new__(SOAREngine)
