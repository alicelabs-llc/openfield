{
  "_comment": "agent-bridge config — edit workdir to the folder you want me to work in. Do NOT change host (must stay 127.0.0.1).",
  "host": "127.0.0.1",
  "port": 7421,
  "workdir": "C:\\Users\\YOUR_USERNAME\\alicelabs-work",
  "secret": "REPLACE_WITH_SECRET_FROM_SHARED_SECRET.txt",
  "timeout_seconds": 120,
  "rate_limit_per_minute": 10,
  "max_output_bytes": 1048576,
  "allow_absolute_paths": false,
  "allow_outside_workdir": false,
  "log_path": "agent-bridge.log",
  "allowlist": [
    "git", "gh", "glab",
    "python", "python3", "pip", "pip3",
    "node", "npm", "npx", "pnpm", "yarn", "bun", "deno", "tsx", "ts-node",
    "ls", "dir", "cat", "type", "head", "tail", "grep", "find", "rg", "fd",
    "wc", "sort", "uniq", "stat", "file", "du", "df",
    "mkdir", "touch", "cp", "copy", "mv", "move", "rm", "del",
    "tar", "zip", "unzip", "7z",
    "curl", "wget", "ping", "nslookup", "traceroute", "tracert",
    "which", "where", "whoami", "hostname", "date", "uname", "systeminfo",
    "tasklist", "ps", "top", "uptime", "env", "printenv",
    "awk", "sed", "cut", "tr", "tee", "jq", "yq",
    "make", "cmake", "cargo", "go", "rustc", "javac", "java", "dotnet"
  ],
  "blocklist": [
    "\\bsudo\\b",
    "\\bsu\\s+-\\b",
    "\\beval\\b",
    "\\bexec\\s*\\(",
    "rm\\s+-rf\\s+[~/]",
    "rm\\s+-rf\\s+/",
    "rm\\s+-rf\\s+\\*",
    ":\\(\\)\\s*\\{\\s*:\\|:&\\s*\\};:",
    "\\bmkfs\\b",
    "\\bdd\\s+if=",
    "\\bformat\\s+[A-Z]:",
    "\\bdel\\s+/[fsq]",
    "\\brd\\s+/s\\b",
    "\\bshutdown\\b",
    "\\breboot\\b",
    "\\bpoweroff\\b",
    "\\bhalt\\b",
    "\\bpasswd\\b",
    "\\buseradd\\b",
    "\\buserdel\\b",
    "\\busermod\\b",
    "\\bchown\\b",
    "chmod\\s+777\\s+/",
    "\\bkillall\\b",
    "\\bpkill\\b",
    "taskkill\\s+/f",
    "curl[^|]*\\|\\s*(ba)?sh",
    "wget[^|]*\\|\\s*(ba)?sh",
    "curl[^|]*-o\\s*/etc",
    "/etc/(passwd|shadow|sudoers)",
    "\\bssh-keygen\\b",
    "\\bssh-copy-id\\b",
    "\\bnc\\s+-l\\b",
    "\\bnetcat\\b",
    "\\biptables\\b",
    "\\bufw\\b",
    "\\bnetsh\\b",
    "\\breg\\s+add\\b",
    "\\bschtasks\\b",
    "\\bcrontab\\b",
    "\\bat\\s+\\d",
    "\\bsystemctl\\s+(start|stop|restart|enable|disable)",
    "\\bservice\\s+(start|stop|restart)",
    "git\\s+push\\s+.*--force",
    "git\\s+push\\s+-f\\b",
    "git\\s+reset\\s+--hard\\s+origin",
    "git\\s+clean\\s+-fdx",
    "git\\s+filter-branch",
    "git\\s+branch\\s+-D\\b",
    "git\\s+remote\\s+remove"
  ]
}
