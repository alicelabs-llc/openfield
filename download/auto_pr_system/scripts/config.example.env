# ============================================
# 🔧 Configuración del Auto PR Sender
# ============================================
# Copia este archivo a ~/.auto-pr-config.env
# y edita los valores con tus tokens.
#
# NUNCA subas este archivo a git ni lo pegues en chat.
# ============================================

# === GitHub ===
# Token con scope: repo, read:org, workflow
# Generar en: https://github.com/settings/tokens/new?scopes=repo,workflow
GITHUB_TOKEN=ghp_tu_token_aqui
GITHUB_USER=eddyflores100-lang

# === Codeberg ===
# Token con scope: issue, repository
# Generar en: https://codeberg.org/user/settings/applications
CODEBERG_TOKEN=tu_codeberg_token_aqui
CODEBERG_USER=eddyflores100

# === GitLab (opcional — pendiente) ===
# GITLAB_TOKEN=
# GITLAB_USER=

# === Comportamiento ===
# Cuántos PRs enviar por plataforma por día
MAX_PER_PLATFORM_PER_DAY=2

# Esperar N segundos entre PRs (anti-spam)
DELAY_BETWEEN_PRS=60

# Enviar a las 9 AM (si usas cron)
SEND_HOUR=9

# Email para notificaciones de resultado (opcional)
NOTIFY_EMAIL=

# === Verificación ===
# Si se setea, el script validará que estés logueado antes de enviar
VERIFY_AUTH=true
