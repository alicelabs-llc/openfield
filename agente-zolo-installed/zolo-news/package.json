{
  "name": "zolo-news",
  "version": "1.0.0",
  "description": "ZOLO NEWS — noticiero matutino autónomo del agente ZOLO: noticias frescas al despertar, clima, curiosidades según tu humor, boletín con avatar (TTS + video) y entrega por correo/Telegram/WhatsApp + complemento MCP para GPT o cualquier IA.",
  "type": "module",
  "main": "agent.js",
  "scripts": {
    "start": "node agent.js run",
    "dry": "node agent.js run --dry-run",
    "schedule": "node agent.js schedule",
    "mcp": "node src/mcp/server.js",
    "test:media": "node test-media.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "zolo",
    "agente",
    "noticias",
    "noticiero",
    "mcp",
    "tts",
    "avatar"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "fast-xml-parser": "^5.11.2",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.2.1",
    "z-ai-web-dev-sdk": "^0.0.18"
  }
}
