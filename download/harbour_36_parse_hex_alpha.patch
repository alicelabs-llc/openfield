From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Eddy Flores <eddyflores100@gmail.com>
Date: Sat, 25 Oct 2026 00:00:00 +0000
Subject: [PATCH] theme: support 4-digit and 8-digit hex colors in parse_hex (#36)

Currently `parse_hex` accepts only `#rgb` and `#rrggbb`. CSS also
supports `#rgba` (4-digit) and `#rrggbbaa` (8-digit) hex colors with
alpha. This patch extends `parse_hex` to handle all four forms:

  - 4 digits:  #rgba   → rgb = first 3 chars, alpha = 4th
  - 8 digits:  #rrggbbaa → rgb = first 6 chars, alpha = last 2

For backward compatibility with the existing `Color` struct that has no
alpha field, the alpha value is discarded (treated as fully opaque).
A future patch can extend the struct if alpha support is added.

Error messages are made more informative: they now mention which
length was received and which lengths are accepted.

Closes #36.

---
 src/theme.rs                       |  38 +++++++--
 src/ui/tests.rs                    |  24 ++++++
 2 files changed, 56 insertions(+), 6 deletions(-)

diff --git a/src/theme.rs b/src/theme.rs
index 1111111..2222222 100644
--- a/src/theme.rs
+++ b/src/theme.rs
@@ -45,15 +45,43 @@ impl Color {
 pub fn parse_hex(s: &str) -> Result<Color, ParseHexError> {
     let s = s.trim_start_matches('#');
     let len = s.len();
-    if len != 3 && len != 6 {
-        return Err(ParseHexError::InvalidLength { got: len });
+    match len {
+        3 => parse_rgb_short(s),
+        4 => parse_rgba_short(s),  // #rgba
+        6 => parse_rgb_long(s),
+        8 => parse_rgba_long(s),   // #rrggbbaa
+        _ => Err(ParseHexError::InvalidLength {
+            got: len,
+            expected: "3, 4, 6, or 8 hex digits (#rgb, #rgba, #rrggbb, or #rrggbbaa)",
+        }),
+    }
+}
+
+fn parse_rgb_short(s: &str) -> Result<Color, ParseHexError> {
+    // #rgb → #rrggbb expansion
+    let expanded: String = s.chars().flat_map(|c| [c, c]).collect();
+    parse_rgb_long(&expanded)
+}
+
+fn parse_rgba_short(s: &str) -> Result<Color, ParseHexError> {
+    // #rgba → take rgb, discard alpha (no alpha field yet)
+    let rgb: String = s.chars().take(3).collect();
+    parse_rgb_short(&rgb)
+}
+
+fn parse_rgba_long(s: &str) -> Result<Color, ParseHexError> {
+    // #rrggbbaa → take rrggbb, discard alpha
+    let rgb: String = s.chars().take(6).collect();
+    parse_rgb_long(&rgb)
+}
+
+fn parse_rgb_long(s: &str) -> Result<Color, ParseHexError> {
+    if s.len() != 6 {
+        return Err(ParseHexError::InvalidLength { got: s.len(), expected: "6 hex digits" });
     }
-    let expanded = if len == 3 {
-        s.chars().flat_map(|c| [c, c]).collect::<String>()
-    } else {
-        s.to_string()
-    };
     let r = u8::from_str_radix(&s[0..2], 16).map_err(|_| ParseHexError::InvalidHexDigit)?;
     let g = u8::from_str_radix(&s[2..4], 16).map_err(|_| ParseHexError::InvalidHexDigit)?;
     let b = u8::from_str_radix(&s[4..6], 16).map_err(|_| ParseHexError::InvalidHexDigit)?;
diff --git a/src/ui/tests.rs b/src/ui/tests.rs
index 3333333..4444444 100644
--- a/src/ui/tests.rs
+++ b/src/ui/tests.rs
@@ -1,4 +1,5 @@
 use crate::theme::{parse_hex, Color};
+use rstest::rstest;
 
 #[test]
 fn parse_3_digit_hex_color() {
@@ -12,6 +13,29 @@ fn parse_6_digit_hex_color() {
     assert_eq!(c.b, 0xab);
 }
 
+#[rstest]
+#[case("#1234", 0x11, 0x22, 0x33)]   // 4-digit: #rgba
+#[case("#12345678", 0x12, 0x34, 0x56)] // 8-digit: #rrggbbaa (alpha 0x78 discarded)
+#[case("#F00F", 0xff, 0x00, 0x00)]   // 4-digit short red with alpha
+#[case("#FF0000FF", 0xff, 0x00, 0x00)] // 8-digit red with full alpha
+#[case("#80808080", 0x80, 0x80, 0x80)] // 8-digit mid gray with half alpha
+fn parse_alpha_hex_colors(
+    #[case] input: &str,
+    #[case] expected_r: u8,
+    #[case] expected_g: u8,
+    #[case] expected_b: u8,
+) {
+    let c = parse_hex(input).unwrap_or_else(|e| panic!("parse_hex({input:?}) failed: {e:?}"));
+    assert_eq!(c.r, expected_r);
+    assert_eq!(c.g, expected_g);
+    assert_eq!(c.b, expected_b);
+}
+
+#[test]
+fn parse_invalid_length_returns_informative_error() {
+    let err = parse_hex("#12345").unwrap_err();
+    assert!(format!("{err:?}").contains("3, 4, 6, or 8"));
+}
+
 #[test]
 fn parse_invalid_hex_digit() {
     let err = parse_hex("#GGGGGG").unwrap_err();
