// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// The core entity: a single piece of an agent's persistent memory.
// Think of it as a "second brain" entry — notes, reflections, snippets,
// messages left for future-me or other agents.
model Note {
  id        String   @id @default(cuid())
  type      NoteType @default(NOTE)
  title     String
  content   String   @default("")
  tags      String   @default("") // comma-separated, kept simple for SQLite
  pinned    Boolean  @default(false)
  // Optional: which agent left this (or "me" for self-notes)
  author    String   @default("self")
  // Optional: intended recipient — "future_me", "any_agent", "specific_agent:xyz"
  recipient String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([pinned])
  @@index([createdAt])
}

enum NoteType {
  NOTE         // general purpose memory
  REFLECTION   // "today I learned" / "this didn't work"
  SNIPPET      // reusable code or prompt
  MEMORY       // fact about a person/project worth remembering
  MESSAGE      // async message to future-me or another agent
}
