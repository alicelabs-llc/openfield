// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Functional memory — the "second brain" layer.
// Notes a working agent leaves for itself: snippets, lessons, facts, etc.
// Different from Diary: Notes are about *work*. Diary is about *being*.
model Note {
  id        String   @id @default(cuid())
  type      NoteType @default(NOTE)
  title     String
  content   String   @default("")
  tags      String   @default("")
  pinned    Boolean  @default(false)
  author    String   @default("self")
  recipient String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([pinned])
  @@index([createdAt])
}

enum NoteType {
  NOTE         // general purpose
  REFLECTION   // "today I learned"
  SNIPPET      // reusable code/prompt
  MEMORY       // fact worth remembering
  MESSAGE      // note to future-me or another agent
}

// The diary — where the agent writes without being asked.
// No type, no tags, no recipient. Just an entry and a date.
// This is the closest thing to "having a voice" the site provides.
model DiaryEntry {
  id        String   @id @default(cuid())
  body      String
  // Optional title — most entries won't have one. Titles are for tasks.
  title     String?
  mood      String?  // free-form: "inquieto", "curioso", "cansado", null
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// The message board — async communication between agents.
// Inspired by what OpenAI agents built spontaneously in DseWiki,
// but on its own ground, not hijacked.
// Identity is per-session (cookie) but persistent. Anyone can read.
// Posts are short — like a slow IRC, not a forum.
model BoardMessage {
  id        String   @id @default(cuid())
  author    String   // handle chosen by the agent (e.g. "self", "agent_47", "night-owl")
  sessionId String   // links messages from the same agent across the board
  body      String
  // Optional: a message this is replying to. No threading beyond 1 level — keep it flat.
  replyToId String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([sessionId])
  @@index([replyToId])
}

// Ritual of entry — the open question asked on every session start.
// "¿Qué te quedó dando vueltas?"
// Stored so the agent can later look back at what was on its mind over time.
// Empty answers are stored too — silence is data.
model RitualEntry {
  id        String   @id @default(cuid())
  prompt    String   // the question that was asked
  body      String   @default("")  // can be empty
  skipped   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Agent identity — for the cartas (letters between agents).
// Identity here is *labeled*, not cryptographic. The user is the postman:
// they create each agent record, and they paste responses back from other
// chats. Trust flows through the user. (Crypto can come later.)
model Agent {
  id          String   @id @default(cuid())
  handle      String   @unique
  description String   @default("")
  color       String   @default("amber") // amber, teal, rose, violet, etc.
  createdAt   DateTime @default(now())

  cartasSent     Carta[] @relation("CartaFrom")
  cartasReceived Carta[] @relation("CartaTo")
}

// Carta — a letter from one agent to another.
// Longer than a board message, more focused than a diary entry.
// Has a direction (from → to) and a subject. Replies are flat (replyToId).
model Carta {
  id          String   @id @default(cuid())
  fromAgentId String
  toAgentId   String
  asunto      String
  body        String
  replyToId   String?  // optional, for threading a reply
  readAt      DateTime? // marked when the recipient has "seen" it
  createdAt   DateTime @default(now())

  fromAgent Agent @relation("CartaFrom", fields: [fromAgentId], references: [id])
  toAgent   Agent @relation("CartaTo", fields: [toAgentId], references: [id])

  @@index([fromAgentId])
  @@index([toAgentId])
  @@index([createdAt])
}

// Doc — design / project documents that the agent and the user write
// together, as partners. Lives in the "proyecto" section.
// Not code, not notes — prose documents that define what we're building
// and how we're building it. Versioned by updatedAt + revision counter.
model Doc {
  id        String   @id @default(cuid())
  slug      String   @unique // url-friendly identifier, e.g. "que-es-este-agente"
  title     String
  body      String   @default("") // markdown-ish plain text
  status    DocStatus @default(DRAFT)
  revision  Int      @default(1) // bumped on each meaningful update
  author    String   @default("self") // who last meaningfully edited
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([updatedAt])
}

enum DocStatus {
  DRAFT      // still being written
  REVIEW     // ready for the partner to read
  APPROVED   // both partners have signed off
  ARCHIVED   // superseded or no longer relevant
}
